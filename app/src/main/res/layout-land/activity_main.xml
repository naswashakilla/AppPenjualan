<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceVariant"
    tools:context=".MainActivity">

    <!-- SIDEBAR -->
    <LinearLayout
        android:id="@+id/sidebar"
        android:layout_width="200dp"
        android:layout_height="match_parent"
        android:background="@color/teal_deep"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saji.id"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Terminal"
            android:textColor="#B0BEC5"
            android:textSize="10sp"
            android:layout_marginBottom="32dp" />

        <!-- Nav Items -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_item"
            android:layout_marginBottom="8dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_menu"
                app:tint="@color/teal_deep" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Dashboard"
                android:textColor="@color/teal_deep"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dummy sidebar items for visuals -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:alpha="0.6">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_transaksi" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Transactions" android:textColor="@color/white" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical"
            android:alpha="0.6">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_pelanggan" app:tint="@color/white" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="Customers" android:textColor="@color/white" android:textSize="13sp" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@color/white"
            android:alpha="0.6" />
    </LinearLayout>

    <!-- TOP HEADER -->
    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="@color/teal_deep"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSapaan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="Selamat Siang!"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvtanggal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="08 Januari 2026"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tvSapaan"
        app:layout_constraintTop_toBottomOf="@id/tvSapaan" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/tvtanggal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvSapaan">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@android:drawable/ic_popup_reminder"
            app:tint="@color/white" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivProfileTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="2dp"
            android:src="@drawable/ic_profile"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
            app:strokeColor="@color/cream"
            app:strokeWidth="1dp" />
    </LinearLayout>

    <!-- MAIN CONTENT SCROLLABLE -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebar"
        app:layout_constraintTop_toBottomOf="@id/headerBg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- MIDDLE SECTION (Estimasi + Quick Actions) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- Estimation Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardEstimasi"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:layout_marginEnd="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="?attr/colorSurface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ESTIMASI HARI INI"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/tvEstimasi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Rp 0"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="32sp"
                                android:textStyle="bold" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_marginBottom="6dp"
                                android:text="Belum ada transaksi"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginVertical="24dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Terjual" android:textSize="10sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textStyle="bold" android:textSize="14sp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Diskon" android:textSize="10sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="#E53935" android:textStyle="bold" android:textSize="14sp"/>
                            </LinearLayout>
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laba Bersih" android:textSize="10sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rp 0" android:textColor="@color/teal_light" android:textStyle="bold" android:textSize="14sp"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- AKSI CEPAT -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AKSI CEPAT"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="12dp" />

                        <!-- Transaksi Item -->
                        <LinearLayout
                            android:id="@+id/btnMenuTransaksi"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_btn_back"
                            android:layout_marginBottom="8dp">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_transaksi" app:tint="@color/teal_deep" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Transaksi" android:textStyle="bold" android:textSize="13sp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mulai penjualan baru" android:textSize="10sp" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@android:drawable/ic_media_play" android:alpha="0.5" />
                        </LinearLayout>

                        <!-- Pelanggan Item -->
                        <LinearLayout
                            android:id="@+id/btnMenuPelanggan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_item"
                            android:layout_marginBottom="8dp">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_pelanggan"
                                app:tint="@color/white" />
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="12dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Pelanggan"
                                    android:textStyle="bold"
                                    android:textSize="13sp"
                                    android:textColor="@color/white"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Manajemen database"
                                    android:textSize="10sp"
                                    android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Laporan Item -->
                        <LinearLayout
                            android:id="@+id/btnMenuLaporan"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_badge_item">
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:src="@drawable/ic_laporan"
                                app:tint="@color/white" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Laporan" android:textStyle="bold" android:textSize="13sp"
                                    android:textColor="@color/white"/>
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lihat statistik detail" android:textSize="10sp" android:textColor="?attr/colorOnSurfaceVariant" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- MANAGEMENT SECTION -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">
                <View
                    android:id="@+id/blueMark"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/teal_deep" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/blueMark"
                    android:layout_marginStart="12dp"
                    android:text="Manajemen Operasional"
                    android:textStyle="bold"
                    android:textSize="16sp" />
                <TextView
                    android:id="@+id/motivasi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Siap melayani pelanggan dengan setulus hati"
                    android:textSize="11sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </RelativeLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="6"
                android:useDefaultMargins="true">

                <!-- Menu Item -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuProduk"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_produk" app:tint="@color/teal_deep" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Menu" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Kategori Item -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuKategori"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_kategori" app:tint="@color/teal_deep" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kategori" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Pegawai Item -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuPegawai"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_pelanggan" app:tint="@color/teal_deep" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pegawai" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Layanan Item -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuLayanan"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_layanan" app:tint="@color/teal_deep" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Layanan" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Cabang Item -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuCabang"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_cabang" app:tint="@color/teal_deep" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cabang" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Printer Item -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btnMenuPrinter"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@drawable/ic_printer" app:tint="@color/teal_deep" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Printer" android:layout_marginTop="8dp" android:textStyle="bold" android:textSize="11sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

            <!-- Footer Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F1F3F4">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="8dp" android:gravity="center_vertical">
                        <View android:layout_width="8dp" android:layout_height="8dp" android:background="@android:color/holo_green_light" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="System Online | Sync: 1 menit yang lalu" android:layout_marginStart="8dp" android:textSize="10sp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="v2.4.1 Premium" android:textSize="10sp" android:background="#E1F5FE" android:paddingHorizontal="8dp" android:paddingVertical="4dp" android:layout_marginEnd="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pro Terminal" android:textSize="10sp" android:background="#E8F5E9" android:paddingHorizontal="8dp" android:paddingVertical="4dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Invisible trigger for the original menu hub -->
    <ImageView
        android:id="@+id/btnMenuTop"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
