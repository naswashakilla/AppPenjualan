<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Penjualan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Palette colors -->
        <item name="colorPrimary">@color/teal_deep</item>
        <item name="colorOnPrimary">@color/cream</item>
        <item name="colorPrimaryContainer">@color/teal_light</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <item name="colorSecondary">@color/teal_light</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">@color/teal_deep</item>

        <!-- Semantic mapping -->
        <item name="colorSurface">@color/surface_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
    </style>

    <style name="Theme.Penjualan" parent="Base.Theme.Penjualan" />
</resources>