<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Penjualan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Palette colors -->
        <item name="colorPrimary">@color/teal_light</item>
        <item name="colorOnPrimary">#000000</item>
        <item name="colorPrimaryContainer">@color/teal_deep</item>
        <item name="colorOnPrimaryContainer">@color/cream</item>

        <item name="colorSecondary">@color/teal_light</item>
        <item name="colorOnSecondary">#000000</item>

        <item name="android:windowBackground">@color/surface_background</item>
        <item name="android:statusBarColor">#000000</item>

        <!-- Semantic mapping -->
        <item name="colorSurface">@color/surface_background</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
    </style>
</resources>